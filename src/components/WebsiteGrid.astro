---
// src/components/WebsiteGrid.astro

export interface Website {
	name: string;
	description: string;
	url: string;
	bgImage: string; // 背景图片路径（以 / 或 http 开头）
	textColor?: string; // 文字颜色，默认白色
	stats?: string; // 可选统计数字
	statsLabel?: string; // 可选统计标签
}

const defaultWebsites: Website[] = [
	{
		name: "OneDrive",
		description: "基于 OneDrive 的资源分发站点——由 YUN-LOVE 开发",
		url: "https://one.031312.xyz",
		bgImage: "/images/QQ_1783774994523.png", //
		textColor: "text-white",
	},
];

const {
	websites = defaultWebsites,
	columns = 3,
	showStats = true,
	title = "",
	subtitle = "",
} = Astro.props;

const colClass =
	{
		1: "grid-cols-1",
		2: "grid-cols-1 sm:grid-cols-2",
		3: "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3",
		4: "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4",
	}[columns] || "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3";
---

<div class="my-6">
  {title && <h2 class="text-2xl font-bold mb-2 text-gray-800 dark:text-gray-100">{title}</h2>}
  {subtitle && <p class="text-gray-500 dark:text-gray-400 mb-6">{subtitle}</p>}

  <div class={`grid ${colClass} gap-6`}>
    {websites.map((site) => (
      <a
        href={site.url}
        target="_blank"
        rel="noopener noreferrer"
        class="group relative block rounded-2xl overflow-hidden
               aspect-[4/3]  // 固定宽高比，让卡片更整齐
               shadow-sm hover:shadow-xl
               transition-all duration-300 ease-out
               hover:-translate-y-1.5
               opacity-85 hover:opacity-100
               border border-gray-200/50 dark:border-gray-700/50
               bg-cover bg-center"
        style={{
          backgroundImage: `url(${site.bgImage})`,
        }}
      >
        {/* 半透明遮罩 - 悬停时变淡，让图片更清晰 */}
        <div class="absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-all duration-300"></div>

        {/* 可选统计标签 */}
        {showStats && site.stats && (
          <div class="absolute top-3 right-3 bg-black/30 backdrop-blur-sm px-2.5 py-0.5 rounded-full text-xs font-medium text-white/90 z-10">
            {site.stats} {site.statsLabel || ''}
          </div>
        )}

        {/* 内容浮层 - 绝对居中 */}
        <div class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center z-10">
          {/* 标题 */}
          <h3 class={`font-bold text-2xl ${site.textColor || 'text-white'} drop-shadow-lg group-hover:text-blue-300 transition-colors`}>
            {site.name}
          </h3>

          {/* 描述 */}
          <p class={`text-sm ${site.textColor || 'text-white/90'} drop-shadow-md mt-2 max-w-[90%] leading-relaxed`}>
            {site.description}
          </p>

          {/* 访问链接 */}
          <div class={`mt-4 text-sm font-medium ${site.textColor || 'text-white/80'} group-hover:text-white transition-colors inline-flex items-center gap-1 drop-shadow-md`}>
            访问 →
          </div>
        </div>
      </a>
    ))}
  </div>
</div>